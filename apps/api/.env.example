PORT=4000
# Atlas: encode @ # etc. in password — @ becomes %40
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/flinkit?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret

# Optional — used by: npm run seed:superadmin
SUPERADMIN_EMAIL=admin@flinkit.com
SUPERADMIN_PASSWORD=Admin@12345
SUPERADMIN_NAME=Flinkit Admin
